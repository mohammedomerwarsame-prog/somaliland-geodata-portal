# Copy to .env and edit. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite (development) or postgresql (production)
DATABASE_ENGINE=sqlite
DATABASE_NAME=geoportal
DATABASE_USER=geoportal
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

MAX_UPLOAD_MB=500
# PRIVATE_MEDIA_ROOT=/srv/geoportal/private_media

PORTAL_NAME=Somaliland GeoData Portal
PORTAL_TAGLINE=Explore • Access • Share Geospatial Data
