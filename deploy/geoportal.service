[Unit]
Description=Somaliland GeoData Portal (gunicorn)
After=network.target postgresql.service

[Service]
User=geoportal
Group=www-data
WorkingDirectory=/srv/geoportal
ExecStart=/srv/geoportal/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 300 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
